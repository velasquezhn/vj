NODE_ENV=development
APP_ENV=local
PORT=4000
DB_PATH=./data/bot_database.sqlite
RECEIPTS_DIR=./public/comprobantes
MAX_RECEIPT_BYTES=5242880
UPLOAD_DIR=./uploads
MAX_IMAGE_BYTES=5242880
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY_HOPS=1
JWT_SECRET=
ADMIN_DEFAULT_USERNAME=
ADMIN_DEFAULT_PASSWORD=
ADMIN_DEFAULT_EMAIL=

# Meta WhatsApp Business Cloud API
WHATSAPP_ENABLED=true
WHATSAPP_API_VERSION=v26.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_ADMIN_NUMBERS=
# Public contact numbers shown to guests, comma-separated, with country code.
PUBLIC_CONTACT_NUMBERS=
PUBLIC_BASE_URL=
WHATSAPP_CABIN_GALLERY_LIMIT=4
PAYMENT_WINDOW_HOURS=24
WHATSAPP_MAX_RETRIES=3
NOTIFICATION_QUEUE_ENABLED=true
NOTIFICATION_QUEUE_INTERVAL_MS=60000

LOG_LEVEL=info
LOG_DIR=./logs
BACKUP_ENABLED=false
BACKUP_DIR=./backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
BACKUP_COMPRESSION=true
BACKUP_VERIFY=true
# Optional free offsite copy. Keep this token only in Railway, never in Git.
BACKUP_DROPBOX_ACCESS_TOKEN=
BACKUP_DROPBOX_FOLDER=VillasJulie/backups
# Optional: weather shown in the WhatsApp menu (OpenWeather API key)
OPENWEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
WEATHER_TIMEOUT_MS=8000
CONVERSATION_SESSION_TTL_MINUTES=60
