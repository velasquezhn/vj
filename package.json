{
  "name": "ijcvwabot",
  "version": "1.0.0",
  "main": "index.js",
  "engines": { "node": ">=20 <25", "pnpm": ">=10" },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "check": "node --check index.js && node --check adminServer.js && node --check routes/whatsappWebhook.js && node --check services/whatsappCloudService.js && node --check scripts/migrate-database.js && node --check scripts/seed-database.js",
    "test": "jest --runInBand --no-coverage",
    "test:watch": "jest --watch --no-coverage",
    "test:coverage": "jest --coverage",
    "test:whatsapp": "jest tests/whatsapp-cloud.test.js --runInBand --no-coverage",
    "test:database": "jest tests/database-bootstrap.test.js --runInBand --no-coverage",
    "test:ci": "jest --runInBand --coverage --ci",
    "security:audit": "pnpm audit --prod --audit-level low",
    "backup:create": "node scripts/manage-backup.js create",
    "backup:restore": "node scripts/manage-backup.js restore",
    "db:migrate": "node scripts/migrate-database.js",
    "admin:create": "node scripts/create_admin_user.js",
    "db:seed": "node scripts/seed-database.js",
    "build": "pnpm run check",
    "validate": "pnpm run build && pnpm test && pnpm run security:audit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.11.0",
    "bcryptjs": "^3.0.2",
    "chrono-node": "^2.8.3",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "dotenv": "^16.5.0",
    "dropbox": "^10.34.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "joi": "^18.0.0",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "multer": "^2.0.2",
    "node-fetch": "^3.3.2",
    "sqlite3": "^6.0.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "description": "",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.0.5",
    "jest-html-reporters": "^3.1.7",
    "jest-junit": "^16.0.0",
    "supertest": "^7.1.4"
  }
}
